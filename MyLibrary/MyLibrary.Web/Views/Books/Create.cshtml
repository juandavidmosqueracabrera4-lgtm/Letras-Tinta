@model CreateBookDTO

@{
	ViewData["Title"] = "Nuevo Libro";
}

<h1>@ViewData["Title"] </h1>

<form asp-action="Create" method="POST">

	<div class="form-floating mb-3">
		<input asp-for="Title" type="text" class="form-control" placeholder="Ingrese el tìtulo">
		<label for="floatingInput">Titulo</label>
		<span asp-validation-for="Title" class="text-danger"></span>
	</div>

	<div class="form-floating mb-3">
		<input asp-for="Description" type="text" class="form-control" placeholder="Ingrese la descripciòn">
		<label for="floatingInput">Descripción</label>
		<span asp-validation-for="Description" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<div class="form-group">
			<label asp-for="AuthorId" class="control-label"></label>
			<select asp-for="AuthorId" asp-items="Model.Authors" class="form-control"></select>
		</div>
	</div>

	<button type="submit" class="btn btn-primary">Guardar</button>

</form>

@section Scripts {

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
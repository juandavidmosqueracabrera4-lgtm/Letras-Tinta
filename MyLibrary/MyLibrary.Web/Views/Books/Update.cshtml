@model UpdateBookDTO

@{
	ViewData["Title"] = "Actualizar Libro";
}

<h1>@ViewData["Title"] </h1>

<form asp-action="Update" method="POST">

	<input type="hidden" asp-for="Id" />

	<div class="form-floating mb-3">
		<input asp-for="Title" type="text" class="form-control" placeholder="Ingrese los nombres">
		<label for="floatingInput">Nombres</label>
	</div>

	<div class="form-floating mb-3">
		<input asp-for="Description" type="text" class="form-control" placeholder="Ingrese los apellidos">
		<label for="floatingInput">Apellidos</label>
	</div>

	<div class="mb-3">
		<div class="form-group">
			<label asp-for="AuthorId" class="control-label"></label>
			<select asp-for="AuthorId" asp-items="Model.Authors" class="form-control"></select>
		</div>
	</div>

	<button type="submit" class="btn btn-primary">Guardar</button>

</form>